<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<title>Quotation {{quotationNumber}}</title>
<style>
  /* ---------- Page setup (A4, page numbers in the footer) ---------- */
  @page {
    size: A4;
    margin: 12mm 12mm 18mm 12mm;
    @bottom-left  { content: "This is a computer generated quotation."; font-family: 'Noto Sans', sans-serif; font-size: 7.5pt; color: #8a8f9c; }
    @bottom-right { content: "Page " counter(page) " of " counter(pages); font-family: 'Noto Sans', sans-serif; font-size: 7.5pt; color: #8a8f9c; }
  }

  /* ---------- Base ---------- */
  body { font-family: 'Noto Sans', sans-serif; font-size: 9.5pt; color: #1f2430; margin: 0; padding: 0; }
  table { border-collapse: collapse; width: 100%; }
  td, th { vertical-align: top; }
  .num { text-align: right; }
  .center { text-align: center; }
  .label { font-size: 7.5pt; font-weight: bold; letter-spacing: 1.2px; color: #e08a00; text-transform: uppercase; margin-bottom: 3px; }

  /* ---------- Header ---------- */
  .header-wrap { background-color: #14213d; color: #ffffff; border-radius: 8px 8px 0 0; padding: 16px 18px 10px 18px; }
  .header td { vertical-align: middle; }
  .h-badge { width: 62px; }
  .badge { width: 50px; height: 50px; line-height: 50px; text-align: center; background-color: #fca311; color: #14213d; font-size: 20pt; font-weight: bold; border-radius: 10px; }
  .h-brand { padding-left: 6px; }
  .brand-name { font-size: 24pt; font-weight: bold; letter-spacing: 4px; text-transform: uppercase; color: #ffffff; }
  .brand-para { font-size: 8.5pt; color: #cfd6e6; margin-top: 2px; }
  .h-doc { text-align: right; width: 150px; }
  .doc-word { font-size: 15pt; font-weight: bold; letter-spacing: 3px; color: #fca311; }
  .doc-no { font-size: 8.5pt; color: #cfd6e6; margin-top: 3px; }
  .contact { font-size: 7.5pt; color: #b7c1d8; border-top: 1px solid #2f4068; margin-top: 12px; padding-top: 7px; }
  .accent-bar { height: 5px; background-color: #fca311; border-radius: 0 0 4px 4px; margin-bottom: 16px; }

  /* ---------- Customer + quotation details ---------- */
  .info td.box { background-color: #f4f6fa; border-radius: 6px; padding: 10px 14px; width: 49%; }
  .info td.gap { width: 2%; }
  .cust-name { font-size: 12pt; font-weight: bold; color: #14213d; margin-bottom: 3px; }
  .line { font-size: 8.5pt; color: #454b5c; margin-top: 1px; }
  .kv td { padding: 2px 0; font-size: 8.5pt; }
  .kv td.k { color: #6a7082; width: 42%; }
  .kv td.v { font-weight: bold; color: #14213d; text-align: right; }

  /* ---------- Items table ---------- */
  .items { margin-top: 18px; }
  .items th { background-color: #14213d; color: #ffffff; font-size: 8pt; letter-spacing: 0.6px; padding: 8px 8px; text-transform: uppercase; }
  .items td { padding: 8px 8px; border-bottom: 1px solid #e3e7ef; font-size: 9pt; }
  .items tr { page-break-inside: avoid; }
  .items .c-sn { width: 28px; }
  .items .c-qty { width: 48px; }
  .items .c-unit { width: 46px; }
  .items .c-rate { width: 80px; }
  .items .c-amt { width: 92px; }
  .item-name { font-weight: bold; color: #14213d; }
  .item-meta { font-size: 8pt; color: #6a7082; margin-top: 2px; white-space: pre-line; }
  .item-size { font-size: 8pt; color: #b36b00; font-weight: bold; margin-top: 2px; }

  /* ---------- Summary ---------- */
  .summary { margin-top: 14px; page-break-inside: avoid; }
  .sum-left { width: 54%; padding-right: 20px; }
  .sum-right { width: 46%; }
  .words { font-size: 9pt; font-weight: bold; color: #14213d; }
  .notes { font-size: 8.5pt; color: #454b5c; white-space: pre-line; }
  .totals td { padding: 5px 10px; font-size: 9pt; border-bottom: 1px solid #e3e7ef; }
  .totals td.k { color: #454b5c; }
  .totals td.v { text-align: right; }
  .totals tr.grand td { background-color: #fca311; color: #14213d; font-size: 11pt; font-weight: bold; border-bottom: none; padding: 9px 10px; }

  /* ---------- Terms + signature ---------- */
  .closing { margin-top: 24px; page-break-inside: avoid; }
  .terms { width: 62%; padding-right: 20px; }
  .terms ol { margin: 3px 0 0 0; padding-left: 15px; }
  .terms li { font-size: 8pt; color: #454b5c; margin-bottom: 2px; }
  .sign { width: 38%; text-align: center; }
  .sign-for { font-size: 8.5pt; color: #454b5c; }
  .sign-space { height: 46px; }
  .sign-line { border-top: 1px solid #14213d; padding-top: 4px; font-size: 8.5pt; font-weight: bold; color: #14213d; }

  .thanks { margin-top: 20px; text-align: center; font-size: 9pt; font-weight: bold; color: #14213d; letter-spacing: 1px; }
</style>
</head>
<body>

{{> partials/header}}

<!-- Customer + quotation details -->
<table class="info">
  <tr>
    <td class="box">
      <div class="label">Quotation for</div>
      <div class="cust-name">{{customer.name}}</div>
      {{#if customer.address}}<div class="line">{{customer.address}}</div>{{/if}}
      {{#if customer.phone}}<div class="line">Phone: {{customer.phone}}</div>{{/if}}
      {{#if customer.email}}<div class="line">Email: {{customer.email}}</div>{{/if}}
      {{#if customer.gstin}}<div class="line">GSTIN: {{customer.gstin}}</div>{{/if}}
    </td>
    <td class="gap"></td>
    <td class="box">
      <div class="label">Quotation details</div>
      <table class="kv">
        <tr><td class="k">Quotation No.</td><td class="v">{{quotationNumber}}</td></tr>
        <tr><td class="k">Date</td><td class="v">{{quotationDate}}</td></tr>
        <tr><td class="k">Valid until</td><td class="v">{{validUntil}}</td></tr>
      </table>
    </td>
  </tr>
</table>

<!-- Items -->
<table class="items">
  <thead>
    <tr>
      <th class="c-sn center">#</th>
      <th>Item / Description</th>
      <th class="c-qty num">Qty</th>
      <th class="c-unit center">Unit</th>
      <th class="c-rate num">Rate (₹)</th>
      <th class="c-amt num">Amount (₹)</th>
    </tr>
  </thead>
  <tbody>
    {{#each items}}
    <tr>
      <td class="center">{{inc @index}}</td>
      <td>
        <div class="item-name">{{name}}</div>
        {{#if size}}<div class="item-size">Size: {{size}}</div>{{/if}}
        {{#if description}}<div class="item-meta">{{description}}</div>{{/if}}
      </td>
      <td class="num">{{quantity}}</td>
      <td class="center">{{unit}}</td>
      <td class="num">{{money rate}}</td>
      <td class="num">{{money amount}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<!-- Summary -->
<table class="summary">
  <tr>
    <td class="sum-left">
      <div class="label">Amount in words</div>
      <div class="words">{{amountInWords}}</div>
      {{#if notes}}
      <div class="label" style="margin-top: 12px;">Notes</div>
      <div class="notes">{{notes}}</div>
      {{/if}}
    </td>
    <td class="sum-right">
      <table class="totals">
        <tr><td class="k">Subtotal</td><td class="v">₹ {{money subtotal}}</td></tr>
        {{#if hasDiscount}}
        <tr><td class="k">Discount</td><td class="v">- ₹ {{money discount}}</td></tr>
        <tr><td class="k">Taxable amount</td><td class="v">₹ {{money taxable}}</td></tr>
        {{/if}}
        <tr><td class="k">GST ({{gstPercent}}%)</td><td class="v">₹ {{money gstAmount}}</td></tr>
        <tr class="grand"><td class="k">Grand Total</td><td class="v">₹ {{money total}}</td></tr>
      </table>
    </td>
  </tr>
</table>

<!-- Terms + signature -->
<table class="closing">
  <tr>
    <td class="terms">
      {{#if terms}}
      <div class="label">Terms &amp; Conditions</div>
      <ol>
        {{#each terms}}<li>{{this}}</li>{{/each}}
      </ol>
      {{/if}}
    </td>
    <td class="sign">
      <div class="sign-for">For <b>{{company.name}}</b></div>
      <div class="sign-space"></div>
      <div class="sign-line">Authorised Signatory</div>
    </td>
  </tr>
</table>

<div class="thanks">THANK YOU FOR YOUR BUSINESS!</div>

</body>
</html>
